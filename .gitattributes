# git-crypt encrypted files

# Configarr secrets

# Environment files
**/.env filter=git-crypt diff=git-crypt
!**/.env.example

# SSL/TLS private keys
**/*-key.pem filter=git-crypt diff=git-crypt
**/privkey.pem filter=git-crypt diff=git-crypt
**/*.key filter=git-crypt diff=git-crypt

# Cloudflare tunnel credentials

# Other secrets
**/passwords.txt filter=git-crypt diff=git-crypt
**/credentials.json filter=git-crypt diff=git-crypt
configs/cloudflared/*.sh filter=git-crypt diff=git-crypt

# Additional service configs with API keys

# SOPS diff driver - show decrypted content in diffs
# (Keep git-crypt entries above for now during migration)
configs/overseerr/settings.json diff=sops
configs/bazarr/config.yaml diff=sops
configs/homarr/*.json diff=sops
configs/prowlarr/config.xml diff=sops

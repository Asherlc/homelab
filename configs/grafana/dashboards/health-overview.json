      "targets": [
        {
          "rawSql": "SELECT\n  er.type AS \"Workout Type\",\n  SUM(er.duration_seconds) AS \"Total Duration\"\nFROM event_record er\nJOIN data_source ds ON er.data_source_id = ds.id\nWHERE ds.user_id = '8737f98d-647a-4e0e-9f6e-c9df5da82d59'\n  AND er.category = 'workout'\n  AND $__timeFilter(er.start_datetime)\nGROUP BY er.type\nORDER BY \"Total Duration\" DESC",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {

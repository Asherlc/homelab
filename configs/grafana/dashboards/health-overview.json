        ]
      },
      "targets": [
        {
          "rawSql": "SELECT\n  er.start_datetime AS \"date\",\n  er.type AS \"type\",\n  er.source_name AS \"device\",\n  er.duration_seconds AS \"duration\",\n  wd.distance,\n  wd.energy_burned,\n  wd.heart_rate_avg AS \"avg_hr\",\n  wd.heart_rate_max AS \"max_hr\"\nFROM event_record er\nJOIN data_source ds ON er.data_source_id = ds.id\nJOIN event_record_detail erd ON erd.record_id = er.id\nLEFT JOIN workout_details wd ON wd.record_id = er.id\nWHERE ds.user_id = '8737f98d-647a-4e0e-9f6e-c9df5da82d59'\n  AND er.category = 'workout'\n  AND $__timeFilter(er.start_datetime)\nORDER BY er.start_datetime DESC",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P8AF694444D512DF3"
          }
        }
      ]
    },

      "targets": [
        {
          "rawSql": "SELECT\n  COUNT(*) AS \"Total Workouts\",\n  SUM(er.duration_seconds) / 3600.0 AS \"Total Hours\",\n  SUM(wd.distance) / 1000.0 AS \"Total Distance\",\n  SUM(wd.energy_burned) AS \"Total Calories\",\n  AVG(wd.heart_rate_avg) AS \"Avg Heart Rate\"\nFROM event_record er\nJOIN data_source ds ON er.data_source_id = ds.id\nJOIN event_record_detail erd ON erd.record_id = er.id\nLEFT JOIN workout_details wd ON wd.record_id = er.id\nWHERE ds.user_id = '8737f98d-647a-4e0e-9f6e-c9df5da82d59'\n  AND er.category = 'workout'\n  AND $__timeFilter(er.start_datetime)",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P8AF694444D512DF3"
          }
        }
      ]
    },

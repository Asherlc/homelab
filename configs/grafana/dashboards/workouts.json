          "rawSql": "SELECT\n  date_trunc('week', er.start_datetime) AS \"Week\",\n  SUM(er.duration_seconds) / 3600.0 AS \"Hours\"\nFROM event_record er\nJOIN data_source ds ON er.data_source_id = ds.id\nWHERE ds.user_id = '8737f98d-647a-4e0e-9f6e-c9df5da82d59'\n  AND er.category = 'workout'\n  AND $__timeFilter(er.start_datetime)\nGROUP BY date_trunc('week', er.start_datetime)\nORDER BY \"Week\"",

tunnel: 2dd6f4cb-7842-47f1-8c49-7e1c2af9aca9
credentials-file: /etc/cloudflared/credentials.json

ingress:
  # Unprotected services
  - hostname: overseerr.asherlc.com
    service: http://overseerr:5055
  - hostname: authentik.asherlc.com
    service: http://authentik-server:9000
  # Protected services through Traefik with proper headers
  - hostname: radarr.asherlc.com
    service: http://traefik:80
    originRequest:
      httpHostHeader: radarr.asherlc.com
      originServerName: radarr.asherlc.com
  - hostname: sonarr.asherlc.com
    service: http://traefik:80
    originRequest:
      httpHostHeader: sonarr.asherlc.com
      originServerName: sonarr.asherlc.com
  - hostname: qbittorrent.asherlc.com
    service: http://traefik:80
    originRequest:
      httpHostHeader: qbittorrent.asherlc.com
      originServerName: qbittorrent.asherlc.com
  - hostname: prowlarr.asherlc.com
    service: http://traefik:80
    originRequest:
      httpHostHeader: prowlarr.asherlc.com
      originServerName: prowlarr.asherlc.com
  - hostname: dashdot.asherlc.com
    service: http://traefik:80
    originRequest:
      httpHostHeader: dashdot.asherlc.com
      originServerName: dashdot.asherlc.com
  - hostname: zigbee2mqtt.asherlc.com
    service: http://traefik:80
    originRequest:
      httpHostHeader: zigbee2mqtt.asherlc.com
      originServerName: zigbee2mqtt.asherlc.com
  - hostname: zigbee.asherlc.com
    service: http://traefik:80
    originRequest:
      httpHostHeader: zigbee.asherlc.com
      originServerName: zigbee.asherlc.com
  - hostname: homarr.asherlc.com
    service: http://traefik:80
    originRequest:
      httpHostHeader: homarr.asherlc.com
      originServerName: homarr.asherlc.com
  - hostname: scrypted.asherlc.com
    service: http://traefik:80
    originRequest:
      httpHostHeader: scrypted.asherlc.com
      originServerName: scrypted.asherlc.com
  - service: http_status:404

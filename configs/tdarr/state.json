{
  "flow": {
    "_id": "hevc-transcode",
    "name": "HEVC Transcode",
    "description": "Transcode video to HEVC using VideoToolbox hardware encoding, CRF-only quality, MKV container. Only replaces original if output is smaller.",
    "flowPlugins": [
      {
        "name": "Input File",
        "sourceRepo": "Community",
        "pluginName": "inputFile",
        "version": "1.0.0",
        "id": "hvcInFile",
        "position": { "x": 500, "y": 100 }
      },
      {
        "name": "Check Video Codec",
        "sourceRepo": "Community",
        "pluginName": "checkVideoCodec",
        "version": "1.0.0",
        "id": "hvcChkCod",
        "position": { "x": 500, "y": 250 },
        "inputsDB": {
          "codec": "hevc"
        }
      },
      {
        "name": "FFmpeg Command Start",
        "sourceRepo": "Community",
        "pluginName": "ffmpegCommandStart",
        "version": "1.0.0",
        "id": "hvcFfStrt",
        "position": { "x": 300, "y": 400 }
      },
      {
        "name": "Set Video Encoder (VideoToolbox HEVC)",
        "sourceRepo": "Community",
        "pluginName": "ffmpegCommandSetVideoEncoder",
        "version": "1.0.0",
        "id": "hvcSetEnc",
        "position": { "x": 300, "y": 550 },
        "inputsDB": {
          "outputCodec": "hevc",
          "ffmpegPresetEnabled": false,
          "ffmpegQualityEnabled": true,
          "ffmpegQuality": 60,
          "hardwareEncoding": true,
          "hardwareType": "videotoolbox",
          "hardwareDecoding": false,
          "forceEncoding": false
        }
      },
      {
        "name": "Set Container (MKV)",
        "sourceRepo": "Community",
        "pluginName": "ffmpegCommandSetContainer",
        "version": "1.0.0",
        "id": "hvcSetCon",
        "position": { "x": 300, "y": 700 },
        "inputsDB": {
          "container": "mkv",
          "forceConform": true
        }
      },
      {
        "name": "FFmpeg Execute",
        "sourceRepo": "Community",
        "pluginName": "ffmpegCommandExecute",
        "version": "1.0.0",
        "id": "hvcFfExec",
        "position": { "x": 300, "y": 850 }
      },
      {
        "name": "Compare File Size Ratio",
        "sourceRepo": "Community",
        "pluginName": "compareFileSizeRatio",
        "version": "2.0.0",
        "id": "hvcChkSiz",
        "position": { "x": 300, "y": 1000 },
        "inputsDB": {
          "greaterThan": 40,
          "lessThan": 100
        }
      },
      {
        "name": "Replace Original File",
        "sourceRepo": "Community",
        "pluginName": "replaceOriginalFile",
        "version": "1.0.0",
        "id": "hvcReplce",
        "position": { "x": 500, "y": 1150 }
      }
    ],
    "flowEdges": [
      { "source": "hvcInFile", "sourceHandle": "1", "target": "hvcChkCod", "targetHandle": null, "id": "e1" },
      { "source": "hvcChkCod", "sourceHandle": "1", "target": "hvcReplce", "targetHandle": null, "id": "e2" },
      { "source": "hvcChkCod", "sourceHandle": "2", "target": "hvcFfStrt", "targetHandle": null, "id": "e3" },
      { "source": "hvcFfStrt", "sourceHandle": "1", "target": "hvcSetEnc", "targetHandle": null, "id": "e4" },
      { "source": "hvcSetEnc", "sourceHandle": "1", "target": "hvcSetCon", "targetHandle": null, "id": "e5" },
      { "source": "hvcSetCon", "sourceHandle": "1", "target": "hvcFfExec", "targetHandle": null, "id": "e6" },
      { "source": "hvcFfExec", "sourceHandle": "1", "target": "hvcChkSiz", "targetHandle": null, "id": "e7" },
      { "source": "hvcChkSiz", "sourceHandle": "1", "target": "hvcReplce", "targetHandle": null, "id": "e8" }
    ]
  },
  "libraries": [
    {
      "name": "Movies",
      "folder": "/media/Movies"
    },
    {
      "name": "TV Shows",
      "folder": "/media/TV Shows"
    }
  ],
  "server": {},
  "node": {
    "name": "LaptopNode",
    "worker_limits": {
      "healthcheckcpu": 2,
      "healthcheckgpu": 0,
      "transcodecpu": 0,
      "transcodegpu": 3
    },
    "schedule": {
      "healthcheckcpu": 2,
      "healthcheckgpu": 0,
      "transcodecpu": 0,
      "transcodegpu": 3
    }
  }
}

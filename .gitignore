# Files too large or not needed in git

# Large databases
*.db
*.db-shm
*.db-wal

# Logs
*.log
*.log.*
**/logs/

# Temporary files
# Homebridge runtime state stays on the server; track configuration and plugins.
configs/homebridge/*
!configs/homebridge/config.json
!configs/homebridge/package.json

*.tmp
*.temp
*.swp
*~

# Configarr cache
**/repos/
**/cfs/cache/

# Media files
*.mkv
*.mp4
*.avi
*.iso

# System files
.DS_Store
Thumbs.db
# Exclude utility scripts with API tokens
configs/cloudflared/*.sh
configs/prowlarr/config.xml

# Terraform
terraform/.terraform/
terraform/*.tfstate*
terraform/.terraform.lock.hcl
terraform/crash.log
terraform/.env
*.env.plain

# Windows starter kit generated build/test files
starter-kit/windows/artifacts/
starter-kit/windows/**/__pycache__/
starter-kit/windows/**/*.pyc
testResults.xml
